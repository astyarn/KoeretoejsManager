@page "/admin-dashboard"

@using KoeretoejsManager.Interfaces
@using KoeretoejsManager.Shared.DTOs
@using KoeretoejsManager.Shared.Enums
@inject IVehicleApiService VehicleApiService

<PageTitle>Admin Dashboard</PageTitle>

<h1>Admin Dashboard</h1>

<button class="btn btn-primary mt-2" @onclick="LoadVehicles">
    Load Køretøjer
</button>


<div class="mt-3">
    <h4>Køretøjer</h4>
    <ul>
        @if (isVehicleListLoaded)
        {
            @foreach (var vehicle in vehicles)
            {
                <li>@vehicle.LicensePlate - @vehicle.Status - @vehicle.NumberOfSeats - @vehicle.RequiredLicense
                    <button class="btn btn-danger btn-sm ms-2"
                            @onclick="() => DeleteVehicle(vehicle.VehicleId)">
                        Slet Køretøj
                    </button>
                </li>
            }
        }
        else
        {
            <li>---</li>
        }
    </ul>
</div>


<br
<EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>License Plate</label>
        <InputText class="form-control" @bind-Value="model.LicensePlate" /> <!--Limitations? custom licenseplates do exist-->
    </div>

    <div>
        <label>Number of Seats</label>
        <InputNumber class="form-control" @bind-Value="model.NumberOfSeats" />
    </div>

    <div>
        <label>Required License</label>
        <InputSelect class="form-control" @bind-Value="model.RequiredLicense">
            @foreach (var value in Enum.GetValues<DrivingLicenseType>())
            {
                <option value="@value">@value</option>
            }
        </InputSelect>
    </div>

    <div>
        <label>Status</label>
        <InputSelect class="form-control" @bind-Value="model.Status">
            @foreach (var value in Enum.GetValues<VehicleStatusType>())
            {
                <option value="@value">@value</option>
            }
        </InputSelect>
    </div>

    <button class="btn btn-primary" type="submit">
        Opret Køretøj
    </button>

    @if (showSuccessMessage)
    {   
        <p class="success-msg">Vehicle added successfully</p>
        <div class="alert alert-success mt-3">
            Tilføjet @successMessage.LicensePlate - @successMessage.Status - @successMessage.NumberOfSeats - @successMessage.RequiredLicense
        </div>
    }
</EditForm>

    @code {
    private CreateVehicleDTO model = new();
    private bool showSuccessMessage = false;
    private VehicleDTO? successMessage = new();

    private List<VehicleDTO> vehicles = new();
    private bool isVehicleListLoaded = false;



    private async Task HandleValidSubmit()
    {
        var createdVehicle = await VehicleApiService.CreateVehicle(model);

        if (createdVehicle != null)
        {
            successMessage = createdVehicle;
            showSuccessMessage = true;

        }
        else
        {
            showSuccessMessage = false;
        }
    }

    private async Task LoadVehicles()
    {
        vehicles = await VehicleApiService.GetAllVehicles();
        if (vehicles.Any())
        {
            isVehicleListLoaded = true;
        }
    }

    private async Task DeleteVehicle(int vehicleId)
    {
        await VehicleApiService.DeleteVehicle(vehicleId);
        await LoadVehicles();
    }
}